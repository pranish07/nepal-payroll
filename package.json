{
  "name": "nepal-mini-payroll",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A small, correct Nepal payroll system with printable payslips and an isolated admin-only component.",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/ensure-web-build.mjs && tsx apps/api/src/server.ts",
    "dev": "concurrently -n api,web -c blue,magenta \"tsx watch apps/api/src/server.ts\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck -w packages/core && npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "seed": "tsx apps/api/src/seed-cli.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "verify": "bash scripts/verify-clean-clone.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "fast-check": "^3.23.2",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4"
  }
}
