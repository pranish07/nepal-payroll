# better-sqlite3@12.9.0 publishes prebuilt binaries for Node 20, 22, 23, 24,
# and 25 on the supported platforms. Its install script runs prebuild-install,
# which downloads the binary matching the current platform and Node ABI, so no
# C++ toolchain is needed. Version 12.10+ stopped publishing Node 20 prebuilds,
# which is why this dependency is pinned exactly. A source rebuild is only the
# fallback if the download is unavailable.
ignore-scripts=false
